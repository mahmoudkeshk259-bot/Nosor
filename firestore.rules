rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // ضع هنا إيميلات المسموح لهم فقط (نفس الإيميلات اللي تنشئها في Authentication)
      allow read, write: if request.auth != null
        && request.auth.token.email in ['admin@example.com', 'second@example.com'];
    }
  }
}
